# Intel Mac CPU-only defaults (6-core i9, no GPU acceleration in Docker)

API_PORT=8080
WEB_PORT=3000
QDRANT_HTTP_PORT=6333
OLLAMA_PORT=11434

QDRANT_URL=http://127.0.0.1:6334
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_THREADS=4
OLLAMA_MAX_LOADED_MODELS=1

API_BUILD_TARGET=dev-api
INGEST_BUILD_TARGET=dev-ingest
API_LOCAL_IMAGE=product-rag-api:dev
INGEST_LOCAL_IMAGE=product-rag-ingest:dev
API_PREBUILT_IMAGE=ghcr.io/amenti-labs-ai/product-rag-api:latest
INGEST_PREBUILT_IMAGE=ghcr.io/amenti-labs-ai/product-rag-ingest:latest

RAG_TOP_K=3
INGEST_RECREATE=true
INGEST_BATCH_SIZE=32
RUST_LOG=info
